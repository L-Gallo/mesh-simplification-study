# =============================================================================
# .gitignore for Mesh Simplification Benchmark Repository
# Thesis: "Comparative Analysis of Open-Source Mesh Simplification Methods
#          for Game Development"
# =============================================================================


# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/
.venv/
.Python

# Jupyter
.ipynb_checkpoints/
*.ipynb


# =============================================================================
# IDE & EDITOR
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~


# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini


# =============================================================================
# C++ BUILD ARTIFACTS (CGAL wrapper)
# =============================================================================
cgal_build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*.vcxproj
*.vcxproj.filters
*.sln
*.dir/
*.tlog/

# Compiled binaries
*.exe
*.dll
*.dylib
*.o
*.a
*.lib


# =============================================================================
# CONFIDENTIAL / NDA ASSETS (Bohemia Interactive - Arma Reforger)
#
# These assets are provided under NDA and must NEVER be committed.
# This covers raw industry meshes, their simplified outputs, all render
# images derived from them, and any test copies.
# =============================================================================
data_collection/raw/
data_collection/simplified/
data_collection/figures/mesh_renders/
data_collection/figures/compressed_renders/
data_collection/figures/cover_image/
data_collection/figures/original_meshes/
data_collection/figures/*.blend
data_collection/figures/*.blend1
data_test/


# =============================================================================
# LARGE MESH & 3D FILES
#
# Mesh files are too large for git. Stanford models (bunny, dragon, etc.)
# should be downloaded from the Stanford 3D Scanning Repository.
# Small test meshes are whitelisted below.
# =============================================================================
*.obj
*.ply
*.stl
*.mtl
*.npz

# Exception: small test meshes for quick pipeline verification
!test_meshes/bunny.obj
!test_meshes/teapot.obj


# =============================================================================
# BINARY EDITOR FILES
#
# Blender project files, Photoshop source files, and ZIP archives.
# These are not diffable and bloat git history.
# =============================================================================
*.blend
*.blend1
*.psd
*.zip


# =============================================================================
# THIRD-PARTY REPOSITORIES
#
# These were cloned locally for the neural methods investigation.
# Link to originals in README instead of embedding copies.
# =============================================================================
neural-mesh-simplification/
MeshCNN/
checkpoints/


# =============================================================================
# DEVELOPMENT ITERATIONS & PILOT DATA
#
# Previous analysis runs, pilot benchmarks, and old output versions.
# Only final results belong in the repository.
# =============================================================================
pilot_meshes/
pilot_results/
simplified_meshes/
input_data/
extras/

# Old/variant analysis iterations (inside data_collection/figures/analysis/)
**/_old*/
**/_no zoom*/
**/_zoom*/

# Root-level figures/ directory (pilot-era heatmaps, to be replaced by results/)
figures/


# =============================================================================
# GENERATED OUTPUTS (re-generable from scripts + data)
#
# Benchmark logs, heatmap PLY files, and intermediate outputs.
# Final figures and CSVs used in the thesis ARE tracked under results/.
# =============================================================================
benchmark_log.txt
*.log

# Heatmap PLY intermediates (the PNG renders are kept, source PLYs are not)
*_heatmap.ply

# Root-level stray files from development
test_output.*
analysis_summary.txt
stats.json
structure.txt
folder_structure.txt

# Old root-level results directory (from neural methods pilot)
results/pooled_meshes/
results/test_input/


# =============================================================================
# PERCEPTUAL STUDY - versioned backups
#
# Only the final participant_responses.json is tracked in data/.
# Intermediate versions stay local.
# =============================================================================
data_collection/survey/participant_responses_v*.json


# =============================================================================
# DOCUMENTATION BUILDS
# =============================================================================
docs/_build/
docs/.doctrees/